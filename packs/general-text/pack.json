{
  "schema_version": "1.0",
  "id": "general-text",
  "version": "1.0.0",
  "format": "text",
  "destination": "content/general-text/published",
  "allowed_research": ["none", "light", "deep"],
  "defaults": {
    "objective": "explain",
    "audience": "general professional",
    "language": "en-GB",
    "length": "300:1200"
  },
  "statistical_voice_score": {"eligible": false},
  "allowed_run_overrides": [
    "objective",
    "audience",
    "language",
    "length",
    "research",
    "structure",
    "destination"
  ],
  "validators": ["output-schema", "word-count", "citation-integrity"],
  "integrity_validators": ["personal-integrity", "provenance", "phrase-overlap"],
  "content_types": [
    "linkedin-post",
    "article",
    "briefing-note"
  ],
  "workflow": [
    "brief",
    "research-if-needed",
    "draft",
    "validate",
    "review",
    "approve",
    "publish",
    "learn"
  ],
  "rubric": "rubric.yaml"
}
