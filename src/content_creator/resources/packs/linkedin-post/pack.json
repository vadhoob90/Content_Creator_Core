{
  "id": "linkedin-post",
  "version": "1.0.0",
  "extends": "general-text",
  "format": "post",
  "destination": "content/linkedin-post/published",
  "defaults": {"length": "50:600"},
  "statistical_voice_score": {"eligible": false},
  "visuals": {
    "supported": true,
    "required": false,
    "execution_classes": ["deterministic", "generative"],
    "aspect_ratios": ["1:1", "4:5"],
    "formats": ["svg", "png", "jpg", "webp"],
    "max_file_size_bytes": 8388608,
    "destination": "content/linkedin-post/visuals",
    "default_role": "portrait-feed",
    "roles": {
      "portrait-feed": {
        "aspect_ratio": "4:5",
        "recommended_width": 1200,
        "recommended_height": 1500,
        "formats": ["svg", "png", "jpg", "webp"],
        "safe_area_profiles": ["feed"],
        "crop_profiles": ["composer-thumbnail"]
      },
      "square-feed": {
        "aspect_ratio": "1:1",
        "recommended_width": 1200,
        "recommended_height": 1200,
        "formats": ["svg", "png", "jpg", "webp"],
        "safe_area_profiles": ["feed"],
        "crop_profiles": ["composer-thumbnail"]
      }
    },
    "safe_areas": [
      {
        "id": "feed",
        "left": 0.05,
        "top": 0.05,
        "right": 0.05,
        "bottom": 0.05,
        "applies_to_roles": ["text", "headline"]
      }
    ],
    "crop_profiles": [
      {
        "id": "composer-thumbnail",
        "visible_area": {
          "x": 0.0,
          "y": 0.0,
          "width": 1.0,
          "height": 0.55,
          "role": "crop"
        },
        "protected_roles": ["headline"]
      }
    ]
  },
  "validators": [],
  "rubric": "rubric.yaml",
  "allowed_research": ["none", "light", "deep"]
}
